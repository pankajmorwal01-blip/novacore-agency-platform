{
  "name": "novacore-agency-platform",
  "private": true,
  "version": "1.0.0",
  "description": "Premium Software Development & AI Solutions Agency Platform",
  "type": "module",
  "scripts": {
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "dev": "vite",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "seed": "cd server && npm run seed",
    "build": "vite build",
    "build:client": "cd client && npm run build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "cd server && npm start"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.2",
    "oxlint": "^1.88.0",
    "vite": "^8.3.4"
  }
}
 