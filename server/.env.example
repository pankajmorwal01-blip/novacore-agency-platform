# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS and reset password links)
CLIENT_URL=http://localhost:5173

# Database Configuration
# Default will try to connect to localhost:27017, and if not running, will automatically fallback to an in-memory/embedded MongoDB instance
MONGODB_URI=mongodb://localhost:27017/novacore_db

# JWT Secret & Expiry
JWT_SECRET=novacore_super_secure_jwt_secret_key_938472938479238472938
JWT_EXPIRES_IN=7d

# Cookie Security (in production, secure=true)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Admin Initial Seed Credentials
ADMIN_NAME=Novacore Executive Admin
ADMIN_EMAIL=admin@novacore.io
ADMIN_PASSWORD=AdminSecurePass2026!
ADMIN_PHONE=+1 (800) 555-0199

# Email Configuration (Nodemailer)
# If left default or unset, emails are logged to console in dev mode
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Novacore Systems" <notifications@novacore.io>

